{
  "version": 2,
  "builds": [
    {
      "src": "frontend/package.json",
      "use": "@vercel/static-build"
    }
  ],
  "env": {
    "NODE_ENV": "production"
  },
  "buildCommand": "npm install && npm run build",
  "outputDirectory": "frontend/dist",
  "routes": [
    { "src": "/(.*)", "dest": "/frontend/dist/$1" }
  ]
}
