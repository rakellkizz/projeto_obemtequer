# ------------------------
# CONFIGURAÇÕES GERAIS
# ------------------------

# Porta onde o servidor irá escutar requisições HTTP.
PORT=5000


# ------------------------
# CONEXÃO COM MONGODB
# ------------------------

# String de conexão com o cluster MongoDB Atlas.
# ⚠️ Mantenha esta informação protegida para evitar acessos indesejados.
MONGO_URI=mongodb+srv://rakellkizz:db_oebj040506@cluster0.9t0uxic.mongodb.net/obemtequer?retryWrites=true&w=majority&appName=Cluster0


# ------------------------
# CHAVES DE API (IA)
# ------------------------

# 🔐 Chave de API da OpenAI (ChatGPT, DALL-E, etc.)
# Nunca exponha essa chave em repositórios públicos.
OPENAI_API_KEY=sk-...      # Insira sua chave secreta da OpenAI aqui

# 🔐 Chave de API da Google Gemini (modelos generativos como o Gemini Pro)
# Usada para chamadas à API generativa do Google.
GEMINI_API_KEY=AIza...     # Insira sua chave da Google Gemini API aqui


# ------------------------
# CHAVES DE API (OUTROS SERVIÇOS)
# ------------------------
JWT_SECRET=sua_chave_super_secreta   # Chave secreta para geração de tokens JWT
